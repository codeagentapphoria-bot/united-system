# =============================================================================
# SUPABASE CONFIGURATION (Recommended)
# =============================================================================
# Get values from: Supabase Dashboard > Settings > Connection Pooling
# Use the same Supabase project as eServices for shared database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PG_USER=postgres
SUPABASE_PG_PASSWORD=your-db-password
SUPABASE_PG_HOST=your-pooler-host.supabase.com
SUPABASE_PG_PORT=6543
SUPABASE_PG_DATABASE=postgres
SUPABASE_PG_SSL=true

# =============================================================================
# LEGACY POSTGRES CONFIG (Deprecated - Use SUPABASE_* above)
# =============================================================================
# PG_USER=postgres
# PG_HOST=localhost
# PG_DATABASE=united_systems
# PG_PASSWORD=postgres
# PG_PORT=5432
# PG_SSL=false

# DEPLOYMENT: must be identical to E-Services multysis-backend JWT_SECRET
JWT_SECRET=replace-with-the-shared-eservices-jwt-secret
JWT_EXPIRES_IN=1d

PORT=5000
# DEPLOYMENT: change to production
NODE_ENV=development
# DEPLOYMENT: set to this service's Railway public URL (e.g. https://bims.up.railway.app)
BASE_URL=http://localhost:8080
# DEPLOYMENT: set to this service's Railway public URL (e.g. https://bims.up.railway.app)
CLIENT_URL=http://localhost:8080

# DEPLOYMENT: set to the E-Services service's Railway public URL (e.g. https://eservice.up.railway.app)
CORS_ORIGIN=http://localhost:8081

# Railway-safe email: use Brevo HTTPS API in production.
BREVO_API_KEY=
EMAIL_FROM_NAME=City of Borongan
EMAIL_FROM_ADDRESS=code.agent.apphoria@gmail.com
EMAIL_SEND_TIMEOUT_MS=10000
GMAIL_USER=
GMAIL_PASS=
SMTP_FROM="City of Borongan <code.agent.apphoria@gmail.com>"

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SETUP_LOCK_ID=54321
DEFAULT_MUNICIPALITY_NAME=Your Municipality
DEFAULT_REGION=Your Region
DEFAULT_PROVINCE=Your Province
DEFAULT_DESCRIPTION=Barangay Information Management System
DEFAULT_ADMIN_EMAIL=admin@your-domain.gov.ph
DEFAULT_ADMIN_PASSWORD=ChangeThisPassword123!
DEFAULT_ADMIN_NAME=System Administrator
