# proc-compose auto-injects this at runtime for local dev.
# DEPLOYMENT: set VITE_API_BASE_URL in Railway dashboard as:
#   https://${{RAILWAY_PUBLIC_DOMAIN}}/api
# Must be HTTPS — the app throws an error on non-localhost HTTP in production.
VITE_API_BASE_URL=http://localhost:3000/api

VITE_PORTAL_URL=http://localhost:3000

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_TIMEOUT=120000

# ─── Maintenance Mode ─────────────────────────────────────────────────────────────
# Set to 'true' to show the maintenance overlay for that section.
# Requires a frontend rebuild to take effect.
VITE_MAINTENANCE_ADMIN=false
VITE_MAINTENANCE_PORTAL=false
VITE_MAINTENANCE_MESSAGE=This section is under maintenance. Please try again later.
